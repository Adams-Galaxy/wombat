{
  "folders": [
    {
      "name": "Wombat",
      "path": "."
    }
  ],
  "extensions": {
    "recommendations": [
      "rust-lang.rust-analyzer",
      "sumneko.lua",
      "tamasfe.even-better-toml",
      "vadimcn.vscode-lldb",
      "davidanson.vscode-markdownlint"
    ]
  },
  "settings": {
    "[rust]": {
      "editor.defaultFormatter": "rust-lang.rust-analyzer",
      "editor.formatOnSave": true
    },
    "[lua]": {
      "editor.defaultFormatter": "sumneko.lua",
      "editor.formatOnSave": true
    },
    "rust-analyzer.check.command": "clippy",
    "rust-analyzer.cargo.allFeatures": true,
    "Lua.runtime.version": "Lua 5.5",
    "Lua.workspace.library": [
      "${workspaceFolder:Wombat}/lua"
    ],
    "Lua.workspace.checkThirdParty": false,
    "search.exclude": {
      "**/target": true
    },
    "files.watcherExclude": {
      "**/target/**": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Wombat: Build",
        "type": "process",
        "command": "cargo",
        "args": ["build"],
        "options": {
          "cwd": "${workspaceFolder:Wombat}"
        },
        "problemMatcher": ["$rustc"],
        "group": {
          "kind": "build",
          "isDefault": true
        }
      },
      {
        "label": "Wombat: Format Check",
        "type": "process",
        "command": "cargo",
        "args": ["fmt", "--check"],
        "options": {
          "cwd": "${workspaceFolder:Wombat}"
        },
        "problemMatcher": []
      },
      {
        "label": "Wombat: Clippy",
        "type": "process",
        "command": "cargo",
        "args": [
          "clippy",
          "--all-targets",
          "--all-features",
          "--",
          "-D",
          "warnings"
        ],
        "options": {
          "cwd": "${workspaceFolder:Wombat}"
        },
        "problemMatcher": ["$rustc"]
      },
      {
        "label": "Wombat: Test",
        "type": "process",
        "command": "cargo",
        "args": ["test", "--all-targets"],
        "options": {
          "cwd": "${workspaceFolder:Wombat}"
        },
        "problemMatcher": ["$rustc"],
        "group": {
          "kind": "test",
          "isDefault": true
        }
      },
      {
        "label": "Wombat: Build Walking Fixture",
        "type": "process",
        "command": "cargo",
        "args": [
          "run",
          "--",
          "--source",
          "tests/fixtures/walking",
          "build",
          "--build-dir",
          "${workspaceFolder:Wombat}/target/wombat-fixture-build"
        ],
        "options": {
          "cwd": "${workspaceFolder:Wombat}"
        },
        "problemMatcher": ["$rustc"]
      },
      {
        "label": "Wombat: Verify",
        "dependsOrder": "sequence",
        "dependsOn": [
          "Wombat: Format Check",
          "Wombat: Clippy",
          "Wombat: Test"
        ],
        "problemMatcher": []
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Wombat: Debug Walking Fixture",
        "type": "lldb",
        "request": "launch",
        "cargo": {
          "args": ["build", "--bin", "wombat"],
          "filter": {
            "name": "wombat",
            "kind": "bin"
          }
        },
        "args": [
          "--source",
          "tests/fixtures/walking",
          "build",
          "--build-dir",
          "${workspaceFolder:Wombat}/target/wombat-fixture-debug"
        ],
        "cwd": "${workspaceFolder:Wombat}"
      }
    ]
  }
}
